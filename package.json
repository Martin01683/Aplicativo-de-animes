{
  "name": "anisync",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "node server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/lib/*.test.ts",
    "format": "prettier --write .",
    "validate": "npx gitleaks detect --redact && npm run typecheck && npm run lint && npm run test && npm run build",
    "prepare": "husky",
    "apk:sync": "npm run build && npx cap sync android",
    "apk:build": "npm run apk:sync && cd android && ./gradlew assembleDebug",
    "apk:release": "npm run apk:sync && cd android && ./gradlew assembleRelease",
    "apk:check": "node scripts/check-android-build.mjs",
    "prepush:check": "npm run validate && node scripts/check-android-build.mjs --pre-push"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/cli": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@google/genai": "^3.6.1",
    "@tailwindcss/vite": "^4.3.5",
    "@vitejs/plugin-react": "^6.3.0",
    "cheerio": "^1.2.0",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "hls.js": "^1.7.4",
    "lucide-react": "^1.78.0",
    "motion": "^14.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^8.3.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nogoo9/gitleaks": "^8.30.1-post.2",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.7.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0",
    "vite-plugin-pwa": "^2.0.0",
    "yaml": "^2.9.1"
  },
  "overrides": {
    "glob": "^14.0.6"
  }
}
