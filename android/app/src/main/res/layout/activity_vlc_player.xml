<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/vlc_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:keepScreenOn="true">

    <org.videolan.libvlc.util.VLCVideoLayout
        android:id="@+id/vlc_video_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fitsSystemWindows="false" />

    <!-- Touch gesture surface (tap HUD, double-tap +/-5s, hold 2x speed) -->
    <View
        android:id="@+id/vlc_touch_layer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:focusable="false" />

    <!-- Hold 2x Speed Pill -->
    <TextView
        android:id="@+id/vlc_hold_speed_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_player_pill_dark"
        android:paddingLeft="14dp"
        android:paddingTop="6dp"
        android:paddingRight="14dp"
        android:paddingBottom="6dp"
        android:text="2× Velocidade"
        android:textColor="#F97316"
        android:textSize="12sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Seek Feedback Badge -->
    <TextView
        android:id="@+id/vlc_seek_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_player_pill_dark"
        android:paddingLeft="16dp"
        android:paddingTop="8dp"
        android:paddingRight="16dp"
        android:paddingBottom="8dp"
        android:text="+5s"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"
        android:fontFamily="monospace"
        android:visibility="gone" />

    <!-- Brightness / Volume Swipe Feedback Badge -->
    <TextView
        android:id="@+id/vlc_gesture_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_player_pill_dark"
        android:paddingLeft="16dp"
        android:paddingTop="9dp"
        android:paddingRight="16dp"
        android:paddingBottom="9dp"
        android:text="Brilho: 70%"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"
        android:fontFamily="monospace"
        android:visibility="gone" />

    <!-- Buffering / Episode Transition Overlay -->
    <LinearLayout
        android:id="@+id/vlc_loading_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="visible">

        <ProgressBar
            android:id="@+id/vlc_buffering"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:indeterminate="true"
            android:indeterminateTint="#F97316" />

        <TextView
            android:id="@+id/vlc_loading_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_player_pill_dark"
            android:paddingLeft="12dp"
            android:paddingTop="5dp"
            android:paddingRight="12dp"
            android:paddingBottom="5dp"
            android:text="Carregando episódio..."
            android:textColor="#E2E8F0"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Error State Overlay -->
    <LinearLayout
        android:id="@+id/vlc_error_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#E60D0F12"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/vlc_error_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Não foi possível reproduzir este vídeo."
            android:textColor="#FCA5A5"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/vlc_btn_retry"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_player_skip_intro"
                android:gravity="center"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:text="Tentar novamente"
                android:textColor="#FB923C"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/vlc_btn_close_error"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:background="@drawable/bg_player_quality_chip"
                android:gravity="center"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:text="Voltar"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Controls HUD Overlay (matches Web AnimePlayer HUD) -->
    <RelativeLayout
        android:id="@+id/vlc_controls_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Top Gradient Bar -->
        <LinearLayout
            android:id="@+id/vlc_top_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:background="@drawable/bg_player_top_gradient"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="12dp"
            android:paddingTop="12dp"
            android:paddingRight="14dp"
            android:paddingBottom="24dp">

            <ImageButton
                android:id="@+id/vlc_btn_back"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Voltar"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_player_arrow_left"
                app:tint="#FFFFFF" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="6dp"
                android:layout_marginRight="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/vlc_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Episódio"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/vlc_series_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#B8CBD8E6"
                    android:textSize="11sp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Top Quick Episodes Chip (matches Web fullscreen top bar) -->
            <LinearLayout
                android:id="@+id/vlc_btn_top_episodes"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:background="@drawable/bg_player_quality_chip"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingLeft="11dp"
                android:paddingRight="11dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:src="@drawable/ic_player_episodes"
                    app:tint="#F97316" />

                <TextView
                    android:id="@+id/vlc_top_episodes_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="Episódios"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Center Circular Orange Play/Pause Button (same look as Web AnimePlayer) -->
        <ImageButton
            android:id="@+id/vlc_btn_play_center"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:layout_centerInParent="true"
            android:background="@drawable/bg_player_circle_orange"
            android:contentDescription="Reproduzir ou pausar"
            android:elevation="8dp"
            android:padding="19dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_player_pause"
            app:tint="#0D0F12" />

        <!-- Bottom Gradient HUD (matches Web AnimePlayer bottom bar) -->
        <LinearLayout
            android:id="@+id/vlc_bottom_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:background="@drawable/bg_player_bottom_gradient"
            android:clickable="true"
            android:focusable="false"
            android:orientation="vertical"
            android:paddingLeft="12dp"
            android:paddingTop="28dp"
            android:paddingRight="12dp"
            android:paddingBottom="10dp">

            <!-- Seekbar row -->
            <SeekBar
                android:id="@+id/vlc_seekbar"
                android:layout_width="match_parent"
                android:layout_height="22dp"
                android:maxHeight="5dp"
                android:minHeight="5dp"
                android:paddingLeft="6dp"
                android:paddingRight="6dp"
                android:progressDrawable="@drawable/seekbar_player_progress"
                android:splitTrack="false"
                android:thumb="@drawable/seekbar_player_thumb" />

            <!-- Main Control Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Left cluster: Play, Mute, Time, -5s, +5s, +{skip}s -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/vlc_btn_play_bottom"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Reproduzir ou pausar"
                        android:padding="7dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_player_pause"
                        app:tint="#FFFFFF" />

                    <ImageButton
                        android:id="@+id/vlc_btn_mute"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Silenciar ou ativar som"
                        android:padding="7dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_player_volume_on"
                        app:tint="#FFFFFF" />

                    <TextView
                        android:id="@+id/vlc_time_current"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="2dp"
                        android:fontFamily="monospace"
                        android:text="0:00"
                        android:textColor="#E2E8F0"
                        android:textSize="11sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:text=" / "
                        android:textColor="#64748B"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/vlc_time_duration"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:fontFamily="monospace"
                        android:text="0:00"
                        android:textColor="#94A3B8"
                        android:textSize="11sp" />

                    <LinearLayout
                        android:id="@+id/vlc_btn_rew5"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginEnd="2dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:paddingLeft="6dp"
                        android:paddingRight="6dp">

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:src="@drawable/ic_player_rew5"
                            app:tint="#E2E8F0" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="3dp"
                            android:fontFamily="monospace"
                            android:text="-5s"
                            android:textColor="#E2E8F0"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/vlc_btn_fwd5"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginEnd="4dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:paddingLeft="6dp"
                        android:paddingRight="6dp">

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:src="@drawable/ic_player_fwd5"
                            app:tint="#E2E8F0" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="3dp"
                            android:fontFamily="monospace"
                            android:text="+5s"
                            android:textColor="#E2E8F0"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/vlc_btn_skip_intro"
                        android:layout_width="wrap_content"
                        android:layout_height="28dp"
                        android:background="@drawable/bg_player_skip_intro"
                        android:fontFamily="monospace"
                        android:gravity="center"
                        android:paddingLeft="9dp"
                        android:paddingRight="9dp"
                        android:text="+85s"
                        android:textColor="#FB923C"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Right cluster: Prev, Episodes, Next, Quality, CC, Settings, Minimize -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/vlc_btn_prev_ep"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Episódio anterior"
                        android:padding="7dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_player_prev_ep"
                        app:tint="#FFFFFF" />

                    <LinearLayout
                        android:id="@+id/vlc_btn_episodes"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:paddingLeft="7dp"
                        android:paddingRight="7dp">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_player_episodes"
                            app:tint="#F97316" />

                        <TextView
                            android:id="@+id/vlc_btn_episodes_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="5dp"
                            android:text="Episódios"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <ImageButton
                        android:id="@+id/vlc_btn_next_ep"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:layout_marginEnd="4dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Próximo episódio"
                        android:padding="7dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_player_next_ep"
                        app:tint="#FFFFFF" />

                    <TextView
                        android:id="@+id/vlc_btn_quality"
                        android:layout_width="wrap_content"
                        android:layout_height="28dp"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/bg_player_quality_chip"
                        android:fontFamily="monospace"
                        android:gravity="center"
                        android:paddingLeft="8dp"
                        android:paddingRight="8dp"
                        android:text="Auto"
                        android:textColor="#E2E8F0"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <ImageButton
                        android:id="@+id/vlc_btn_tracks"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Legendas"
                        android:padding="7dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_player_subtitles"
                        app:tint="#CBD5E1" />

                    <ImageButton
                        android:id="@+id/vlc_btn_settings"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Configurações do player"
                        android:padding="7dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_player_settings"
                        app:tint="#FFFFFF" />

                    <ImageButton
                        android:id="@+id/vlc_btn_fullscreen"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Sair da tela cheia"
                        android:padding="7dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_player_minimize"
                        app:tint="#FFFFFF" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </RelativeLayout>

    <!-- In-Player Dark Settings Menu Overlay (bottom-right, matches Web Settings Popover) -->
    <FrameLayout
        android:id="@+id/vlc_settings_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/vlc_settings_card"
            android:layout_width="290dp"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="14dp"
            android:layout_marginBottom="68dp"
            android:background="@drawable/bg_player_menu_panel"
            android:clickable="true"
            android:elevation="12dp"
            android:focusable="true"
            android:orientation="vertical"
            android:padding="8dp">

            <LinearLayout
                android:id="@+id/vlc_settings_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingLeft="6dp"
                android:paddingTop="4dp"
                android:paddingRight="6dp"
                android:paddingBottom="8dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_player_arrow_left"
                    app:tint="#FFFFFF" />

                <TextView
                    android:id="@+id/vlc_settings_header_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="Configurações"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <View
                android:id="@+id/vlc_settings_header_divider"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginBottom="6dp"
                android:background="#1AFFFFFF"
                android:visibility="gone" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/vlc_settings_items"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>
        </LinearLayout>
    </FrameLayout>

    <!-- In-Fullscreen Episode Selector Drawer (right side, matches Web AnimePlayer Drawer) -->
    <FrameLayout
        android:id="@+id/vlc_episodes_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/vlc_episodes_drawer"
            android:layout_width="320dp"
            android:layout_height="match_parent"
            android:layout_gravity="end"
            android:background="#F5151921"
            android:clickable="true"
            android:elevation="14dp"
            android:focusable="true"
            android:orientation="vertical">

            <!-- Drawer Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingLeft="16dp"
                android:paddingTop="12dp"
                android:paddingRight="10dp"
                android:paddingBottom="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Episódios"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/vlc_episodes_series_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="#94A3B8"
                        android:textSize="11sp"
                        android:visibility="gone" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/vlc_btn_close_episodes"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Fechar lista de episódios"
                    android:padding="7dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_player_close"
                    app:tint="#94A3B8" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#1AFFFFFF" />

            <TextView
                android:id="@+id/vlc_episodes_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="28dp"
                android:text="Lista de episódios indisponível para este título."
                android:textColor="#94A3B8"
                android:textSize="12sp"
                android:visibility="gone" />

            <ScrollView
                android:id="@+id/vlc_episodes_scroll"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:padding="8dp">

                <LinearLayout
                    android:id="@+id/vlc_episodes_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
